---
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
---

<header class="teaser" {...storyblokEditable(blok)}>
	<h1>{blok.headline}</h1>
</header>

<style>
	.teaser {
		color: var(--teaser-text);
		background-color: var(--teaser-bg);
		border-radius: 24px;
		text-align: center;
		padding: 4rem 1rem;
	}

	h1 {
		color: inherit;
	}
</style>
