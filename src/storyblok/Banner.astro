---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;

const headingId = `banner-${blok._uid}`;
---

<section
	class="banner"
	aria-labelledby={headingId}
	{...storyblokEditable(blok)}
>
	<h2 id={headingId}>{blok.headline}</h2>
	{blok.text && <p>{blok.text}</p>}
	{
		blok.cta?.map((nestedBlok) => {
			return <StoryblokComponent blok={nestedBlok} />;
		})
	}
</section>

<style>
	.banner {
		/* Nested buttons and focus rings pick up the banner's colours */
		--button-bg: var(--banner-button-bg);
		--button-text: var(--banner-button-text);
		--button-hover-bg: var(--banner-button-hover-bg);
		--focus: var(--banner-focus);

		display: grid;
		justify-items: start;
		gap: 1rem;
		padding: clamp(2rem, 5vw, 4rem);
		color: var(--banner-text);
		background-color: var(--banner-bg);
		border-radius: 24px;
	}

	h2 {
		color: var(--banner-heading);
	}

	p {
		max-inline-size: 60ch;
		margin-block-end: 0.5rem;
	}
</style>
