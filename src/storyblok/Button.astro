---
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;

const link = blok.link;
let href;
if (link?.linktype === 'story' && link.cached_url) {
	href = `/${link.cached_url.replace(/^\//, '')}`;
} else if (link?.linktype === 'email' && link.email) {
	href = `mailto:${link.email}`;
} else if (link?.url) {
	href = link.url;
}
if (href && link.anchor) {
	href += `#${link.anchor}`;
}
const opensNewTab = link?.target === '_blank';
---

{
	blok.label && href && (
		<a
			class="button"
			href={href}
			target={opensNewTab ? '_blank' : undefined}
			rel={opensNewTab ? 'noopener noreferrer' : undefined}
			{...storyblokEditable(blok)}
		>
			{blok.label}
			{opensNewTab && <span class="visually-hidden"> (opens in a new tab)</span>}
		</a>
	)
}

<style>
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-block-size: 2.75rem;
		padding: 0.5rem 1.5rem;
		/* Transparent border stays visible in forced-colours mode */
		border: 2px solid transparent;
		border-radius: 999px;
		color: var(--button-text);
		background-color: var(--button-bg);
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
	}

	.button:hover {
		background-color: var(--button-hover-bg);
		text-decoration: underline;
	}
</style>
